<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Anabiosis.Shared\Anabiosis.Shared.csproj" />
    <ProjectReference Include="..\Anabiosis.Server\Anabiosis.Server.csproj" />
    <!-- CustomShipStore.cs (редактор корабля, humble-soaring-cat.md Step 5) has no MonoGame
         dependency of its own - only System.IO/Text.Json/Anabiosis.Shared - so it's worth
         referencing Client just for that one class's own storage-level test, rather than
         duplicating its write-to-temp-then-move logic a second time just to keep it out of Tests. -->
    <ProjectReference Include="..\Anabiosis.Client\Anabiosis.Client.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- windows, not plain net9.0 - CustomShipStore.cs's own test (below) needs to reference
         Anabiosis.Client, which targets net9.0-windows (MonoGame/WinForms) - this project has
         always only ever been run on Windows, so this changes nothing about how it actually runs. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
