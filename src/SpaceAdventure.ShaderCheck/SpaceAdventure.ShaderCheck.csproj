<Project Sdk="Microsoft.NET.Sdk">

  <!-- Deliberately a separate project rather than cases in SpaceAdventure.Tests: everything here
       needs a real GPU and a window, and the main suite has to stay headless so it can run
       anywhere. This one is run on demand, whenever a shader or the render path changes. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpaceAdventure.Client\SpaceAdventure.Client.csproj" />
  </ItemGroup>

</Project>
