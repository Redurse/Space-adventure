<?xml version="1.0" encoding="utf-8"?>
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Arial</FontName>
    <Size>16</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <!-- Any character outside the regions below now draws as '?' instead of throwing out of
         SpriteBatch.DrawString. A missing glyph is a cosmetic problem; taking the whole game down
         over one is not, and it has already happened twice (the em dash below, then a degree sign
         in the turret readout, which crashed the moment anyone manned a gun). -->
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <!-- Latin-1 symbols actually used in the HUD: the degree sign for turret elevation. -->
      <CharacterRegion>
        <Start>&#xA0;</Start>
        <End>&#xFF;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#x0400;</Start>
        <End>&#x04FF;</End>
      </CharacterRegion>
      <!-- General punctuation (em/en dash, curly quotes, ellipsis) — a stray "—" here crashed
           SpriteBatch.DrawString outright instead of just looking wrong, so cover it defensively. -->
      <CharacterRegion>
        <Start>&#x2010;</Start>
        <End>&#x2027;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
